DATABASE_URL=postgres://pi:pi@127.0.0.1:55432/pi_agents
API_KEYS={"replace-with-a-long-random-token":"demo"}
HOST=127.0.0.1
PORT=8080
# Set only behind a TLS proxy, with no trailing slash:
# CONSOLE_ORIGIN=https://agents.example.com
# Trust forwarding headers only behind a proxy with no direct API access.
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=10
ROLE=all
ARTIFACT_DIR=.data/artifacts
SANDBOX_IMAGE=pi-managed-sandbox:dev
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Opt-in live acceptance suite (uses provider credits)
LIVE_MODEL=openai/gpt-4.1-mini

# Optional Linux desktops. Both the API and worker need these settings.
# The desktop host has its own .env.desktop with the SAME token.
# DESKTOP_HOST_URL=http://127.0.0.1:8090
# DESKTOP_HOST_TOKEN=generate-a-separate-random-token-of-at-least-32-characters
# DESKTOP_LIVE_MODEL=deepseek/deepseek-v4.1-flash-1017
